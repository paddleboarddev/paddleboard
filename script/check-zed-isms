#!/usr/bin/env bash
# check-zed-isms — catch fork-rename breakage before it ships.
#
# PaddleBoard renamed crates/zed -> crates/paddleboard and the `zed` package ->
# `paddleboard`, but upstream-inherited scripts and code keep referencing the
# old names. Those references build/run fine in CI paths nobody exercises and
# then explode on a user's machine (script/install-linux died on
# `crates/zed/RELEASE_CHANNEL`; bundle-linux built `--package zed`, which does
# not exist). This gate fails on the high-signal patterns:
#
#   - paths under crates/zed/            (the directory does not exist)
#   - cargo refs to the `zed` package    (--package zed / -p zed / get-crate-version zed)
#   - ZED_* env vars in scripts          (the app reads PADDLEBOARD_*; a ZED_ export
#                                         is invisible to it — bundle-mac shipped with
#                                         ZED_BUNDLE so the bundled git went unused)
#   - half-renamed prose                 (a "Zed" line within 5 lines of a PADDLEBOARD_*
#                                         token — see the half-rename check below)
#
# Files that legitimately keep Zed names are allowlisted below — they are
# upstream packaging/CI for formats PaddleBoard does not ship. If you PORT one
# of them, remove it from the allowlist so regressions get caught.

set -euo pipefail
cd "$(dirname "$0")/.."

# Upstream-inherited files PaddleBoard does not use; kept un-ported to minimize
# weekly-merge conflicts. Porting one? Remove it from this list.
ALLOWLIST=(
  "script/bundle-freebsd"            # FreeBSD packaging (mostly commented out upstream)
  "script/bundle-windows.ps1"        # Windows packaging — port pending if Windows becomes a target
  "script/snap-build"                # Snap packaging (not shipped)
  "script/flatpak/"                  # Flatpak packaging (not shipped)
  "script/upload-nightly"            # Zed nightly-release CI
  "script/upload-extension-cli"      # Zed extension-registry CI
  "script/zed-local"                 # Zed collab-dev helper
  "script/generate-action-metadata"  # Zed docs CI
  "script/lib/"                      # shared helpers for the above
  "script/cargo"                     # Zed CI cargo wrapper
  "script/randomized-test-ci"        # Zed collab randomized-test CI
  "script/triage_project_sync.py"    # Zed issue-triage bot
  "script/kube-shell"                # Zed collab kube tooling
  "script/setup-dev-driver.ps1"      # Zed Windows dev tooling
  "script/check-zed-isms"            # this gate (patterns appear in its own text)
  "script/check-dropped-upstream-files"          # maps upstream paths -> renamed ones; must name both
  "script/dropped-upstream-files-allowlist.txt"  # entries ARE upstream paths, by design
  ".github/CODEOWNERS.hold"          # parked upstream file, inert
  "docs/"                            # inherited upstream docs (carry redirect banners instead)
  "crates/paddleboard/resources/flatpak/"  # inert flatpak manifests (not shipped)
  "crates/git_hosting_providers/"    # permalink tests use fictional crates/zed paths as fixtures
  # --- zed:// URL scheme: files where the OLD scheme is deliberately present ---
  "crates/terminal/src/alacritty/hyperlinks.rs"  # linkifies many external schemes; recognising Zed's is correct
  "crates/acp_thread/src/mention.rs"             # legacy zed:// mentions are re-emitted as paddleboard://; tests pin that
  "crates/agent_skills/agent_skills.rs"          # asserts the pre-fix zed:// share scheme STAYS rejected
)

allowlisted() {
  for entry in "${ALLOWLIST[@]}"; do
    case "$1" in
      "$entry"*) return 0 ;;
    esac
  done
  return 1
}

# Searched areas: scripts, workflows, source, and assets. Markdown prose is NOT
# scanned — internal docs legitimately mention old paths when describing the
# rename. sentry-cli's `-p zed` is its project flag, not a cargo package ref.
mapfile -t hits < <(
  {
    grep -rnE 'crates/zed/' script/ .github/ crates/ assets/ 2>/dev/null \
      | grep -v 'zed-industries/zed' || true
    grep -rnE '(--package|-p) zed([^-_a-zA-Z0-9]|$)|get-crate-version zed([^-_a-zA-Z0-9]|$)' script/ .github/ 2>/dev/null \
      | grep -v 'sentry-cli' || true
    grep -rnE '\bZED_[A-Z_]+' script/ 2>/dev/null || true
    # App-bundle binary paths. PB's binary is `paddleboard`, so a literal
    # "Contents/MacOS/zed" resolves to a file that does not exist — and because
    # it's a runtime path join, nothing fails to compile. This shipped broken:
    # `paddleboard --foreground` was dead on macOS in every release until
    # 2026-07-26 (crates/cli/src/main.rs). String literals were the gap in this
    # gate's original patterns, which only covered crates/zed/ and -p zed.
    grep -rnE 'MacOS/zed([^-_a-zA-Z0-9]|$)' script/ .github/ crates/ assets/ 2>/dev/null || true
    # The `zed://` URL scheme. PaddleBoard registers `paddleboard://` (see the
    # app's CFBundleURLSchemes), so a zed:// URL in shipped code is unroutable —
    # it either fails or opens Zed. This shipped twice: skill share links, and
    # `$schema` in assets/settings/default.json. Comment lines are skipped, since
    # docs legitimately describe the old scheme when explaining the rename.
    grep -rnE 'zed://' script/ .github/ crates/ assets/ 2>/dev/null \
      | grep -vE ':[0-9]+:[[:space:]]*(//|#|\*)' || true
  } | sort -u
)

failures=0
for hit in "${hits[@]:-}"; do
  [ -z "$hit" ] && continue
  file="${hit%%:*}"
  file="${file#./}"
  if ! allowlisted "$file"; then
    echo "ZED-ISM: $hit" >&2
    failures=$((failures + 1))
  fi
done

# --- half-rename check ------------------------------------------------------
# Catches user-facing prose left saying "Zed" while the code around it was
# renamed. The signature is proximity: a `Zed` line within 5 lines of a
# `PADDLEBOARD_*` token. The run-as-root guard shipped in v0.2.6 printing
# "Running Zed as root ..." three lines above `PADDLEBOARD_ALLOW_ROOT=true` —
# half-renamed, and invisible to every pattern above (crates/util/src/util.rs).
#
# Proximity is the whole trick. Scanning all `Zed` string literals under crates/
# yields ~168 hits, nearly all legitimate (Zed Cloud, keymap-compat names,
# release_channel) — too noisy to gate on. Scanning only print/log macros yields
# 3 and would have MISSED this bug, because the offending line is a continuation
# inside a multi-line string with no macro token on it. Proximity to a renamed
# symbol yields 3 hits repo-wide, all genuine, listed below.
#
# Comment lines are skipped: a `// PaddleBoard:` tag explaining a rename names
# both products by design.

# Content patterns, NOT file paths: these lines mention Zed correctly. Keyed by
# content so the whole file stays covered — crates/cli/src/main.rs is where the
# `MacOS/zed` bug shipped, so blanket-allowlisting it would reopen that hole.
HALF_RENAME_OK=(
  'dev\.zed\.Zed'                          # upstream Flatpak app id, matched verbatim
  'LanguageModelProviderName::new\("Zed"\)' # Zed Cloud provider, deliberately named
  '"Sign in to use Zed"'                   # Zed Cloud sign-in, deliberately named
)

half_rename_ok() {
  for pattern in "${HALF_RENAME_OK[@]}"; do
    if printf '%s' "$1" | grep -qE "$pattern"; then
      return 0
    fi
  done
  return 1
}

mapfile -t half_hits < <(
  find script .github crates assets -type f 2>/dev/null \
    | grep -vE '\.(png|jpe?g|gif|ico|icns|ttf|otf|woff2?|wasm|dylib|so|a|zip|gz|db|bin|mp4|webm|pdf)$' \
    | tr '\n' '\0' \
    | xargs -0 awk '
        function flush(   i, j, lo, hi, near) {
          for (i = 1; i <= n; i++) {
            if (!zed[i]) continue
            if (line[i] ~ /^[ \t]*(\/\/|#|\*)/) continue
            lo = i - 5; if (lo < 1) lo = 1
            hi = i + 5; if (hi > n) hi = n
            near = 0
            for (j = lo; j <= hi; j++) if (env[j]) { near = 1; break }
            if (near) printf "%s:%d:%s\n", prev, i, line[i]
          }
        }
        FILENAME != prev {
          if (prev != "") flush()
          prev = FILENAME; n = 0
          split("", line); split("", env); split("", zed)
        }
        {
          n++; line[n] = $0
          if ($0 ~ /PADDLEBOARD_[A-Z_]+/) env[n] = 1
          if ($0 ~ /(^|[^A-Za-z0-9_])Zed([^A-Za-z0-9_]|$)/) zed[n] = 1
        }
        END { if (prev != "") flush() }
      ' 2>/dev/null | sort -u
)

half_failures=0
for hit in "${half_hits[@]:-}"; do
  [ -z "$hit" ] && continue
  file="${hit%%:*}"
  file="${file#./}"
  if ! allowlisted "$file" && ! half_rename_ok "$hit"; then
    echo "HALF-RENAME: $hit" >&2
    half_failures=$((half_failures + 1))
  fi
done

# --- user-facing prose check ------------------------------------------------
# Prose saying "Zed" in a string a user reads. The half-rename check above only
# fires when a PADDLEBOARD_* token happens to sit within 5 lines, so prose with
# no renamed symbol nearby sails through — that is how "Zed needs an
# xdg-desktop-portal implementation" passed this gate clean both before and
# after it was fixed.
#
# The signal is sentence shape, not the macro a string sits in. Scanning by
# macro (println!/bail!/...) misses UI text entirely, which is where most
# user-facing strings in this app live: `Label::new("...")`, `.tooltip(...)`,
# settings descriptions. So: a double-quoted literal containing the word Zed
# and at least three whitespace-separated words. Single words ("Zed"), two-word
# labels, identifiers and URLs are excluded by the word count.
#
# Measured on the tree when this was written: 156 literals contain "Zed", 107
# are prose by that rule, and the path + content exclusions below cut it to the
# genuine set. 16 real user-facing strings were fixed in the same commit that
# added this check; what remains here is allowlisted with a reason.
#
# `///` doc comments are scanned too, but only in crates/cli: clap renders them
# into `--help`, which makes them user-facing prose despite being comments.
# (Found exactly one that way — `--system-specs`, half-renamed.)

# Paths whose strings never reach a user.
PROSE_PATH_SKIP='(_tests?\.rs$|/tests?/|/evals/|/benches/|/fixtures/|^crates/docs_preprocessor/|^crates/eval_cli/|^crates/benchmarks/|^crates/zed_eval)'

# Content where "Zed" is the correct word. Keyed by content, not path, so the
# rest of each file stays covered.
PROSE_OK=(
  'Zed Pro'                    # Zed's subscription tier
  'Zed VIP'
  'Zed account'                # Zed Cloud sign-in
  "Zed's hosted"               # Zed Cloud models
  'Zed AI'                     # Zed's hosted AI service
  'Zed team'                   # rating sends the thread to Zed, not to us
  'Zed Cloud'
  'Zed models (enabled|disabled)'  # Zed Cloud business-plan states
  'Sign in to use Zed'         # deliberate: the service really is Zed's
  'fork of Zed'                # crediting upstream, on purpose
  'managed by Zed'             # Zed Cloud manages the header
  "Zed's built-in Zeta"        # Zeta is Zed's model
  'Zed Plex'                   # real font family names
  'Zed Industries'             # upstream copyright string, legally theirs
  'Zed Keybind Context'        # names upstream's keymap-context concept
  'Zed > Editor'               # keymap context example, same concept
  'Zed server'                 # collab, removed here and inert
  'Zed ones|Zed tasks|Zed debug templates|Zed format'  # anyhow context, never user-visible
  'Handshake (before|after) Zed spawn'                 # anyhow context
  'Zed managed Node'           # log line, not UI
  'Hello from Zed'             # ACP echo fixture living outside a tests/ dir
  'the Zed logo'               # visual-test prompt
  'Zed X Copilot'              # asset name
  'ENV=Zed'                    # env-var example in a placeholder
  'Zed created it|worktree Zed created'  # internal invariant messages
  'Linux Zed release'          # picks an upstream release for WSL, correctly named
  'GPU Zed is running on'      # minidump field descriptions; telemetry is inert
  'sharing a project in Zed'   # collab component preview, collab is removed
  "Zed's agent with any ACP"   # component preview string
  "author: Zed"                # markdown parser test data in a non-test file
  "name: 'Zed'"                # vim surround test data in a non-test file
  'Zed task variables'         # doc comment on a test helper
  # --- Zed Cloud update path: renaming these would make them WRONG -----------
  # Both buttons link to https://zed.dev/releases on the inert Zed AI error
  # path. "Update PaddleBoard" pointing at Zed's download page is worse than
  # leaving accurate text on a screen no PaddleBoard user reaches.
  '"Update Zed"'
  'update to Zed version'          # ZedUpdateRequiredError, paired with that same button
  'Enable Fast Mode for Zed'       # Zed Cloud's own feature
  # --- test and component-preview fixtures in non-test files ----------------
  # `mod tests` blocks and `render_*_preview` helpers live inside ordinary
  # source files, so a path-based skip cannot see them.
  'Authorize Zed in your browser'  # acp/elicitation test + preview fixtures
  'Choose how Zed should connect'  # elicitation form preview fixture
  # --- internal docs, not rendered anywhere a user looks --------------------
  "current Zed window's sidebar"   # doc on an IPC enum variant, not clap help
  'When Zed started not as an'     # doc on the FORCE_CLI_MODE static
  'Zed act like netcat'            # clap arg, but `hide = true`
  'by the Zed side'                # doc on a private fn
  'failed to copy Zed update'      # anyhow context in the updater
  "'Zed'"                          # vim surround test data; the cursor marker sits mid-token
)

prose_ok() {
  for pattern in "${PROSE_OK[@]}"; do
    if printf '%s' "$1" | grep -qE "$pattern"; then
      return 0
    fi
  done
  return 1
}

mapfile -t prose_hits < <(
  {
    # The optional groups matter: "Zed needs an xdg-desktop-portal..." puts Zed
    # at the very start of the literal, so a pattern demanding a non-word char
    # on both sides misses it — which is the exact bug that motivated this
    # check. Verified by injecting a regression before trusting a clean run.
    # Whole lines, not `grep -o`: -o prints only the matched literal, so the
    # line's leading `//` never reaches the comment filter and a disabled
    # `#[allow(reason = "...about Zed")]` reads as live prose. The literal is
    # extracted afterwards, in the awk stage below.
    grep -rnE '"([^"]*[^A-Za-z0-9_])?Zed([^A-Za-z0-9_][^"]*)?"' crates/ --include=*.rs 2>/dev/null \
      | grep -vE ':[0-9]+:[[:space:]]*(//|#|\*)' || true
    grep -rnoE '///.*[^A-Za-z0-9_]Zed([^A-Za-z0-9_]|$).*' crates/cli --include=*.rs 2>/dev/null || true
  } \
    | awk -v skip="$PROSE_PATH_SKIP" '
        {
          # Match the path skip against the FILE field only. Anchored patterns
          # like _tests?\.rs$ cannot match the whole grep line, which carries a
          # trailing :line:content — that mistake let every *_tests.rs through.
          i = index($0, ":")
          if (i == 0) next
          file = substr($0, 1, i - 1)
          if (file ~ skip) next
          rest = $0
          if (!match(rest, /^[^:]*:[0-9]+:/)) next
          prefix = substr(rest, 1, RLENGTH)
          rest = substr(rest, RLENGTH + 1)

          # Pull out the first double-quoted run that mentions Zed, so the word
          # count below measures the sentence and not the surrounding code.
          # Doc-comment lines carry no quotes and are measured whole.
          seg = rest
          if (rest ~ /"/) {
            seg = ""
            tail = rest
            while (match(tail, /"[^"]*"/)) {
              cand = substr(tail, RSTART, RLENGTH)
              if (cand ~ /(^|[^A-Za-z0-9_])Zed([^A-Za-z0-9_]|$)/) { seg = cand; break }
              tail = substr(tail, RSTART + RLENGTH)
            }
            if (seg == "") next
          }

          n = split(seg, w, /[ \t]+/)
          if (n >= 3) print prefix seg
        }' \
    | sort -u
)

prose_failures=0
for hit in "${prose_hits[@]:-}"; do
  [ -z "$hit" ] && continue
  file="${hit%%:*}"
  file="${file#./}"
  if ! allowlisted "$file" && ! prose_ok "$hit"; then
    echo "ZED-PROSE: $hit" >&2
    prose_failures=$((prose_failures + 1))
  fi
done

# --- renamed-symbol check ---------------------------------------------------
# A `ZED_X` where the fork also defines `PADDLEBOARD_X`. The counterpart is the
# proof of a rename, so a surviving `ZED_X` is either a leftover or an upstream
# reintroduction. This is exactly how `agent::ZED_AGENT_ID` came back in the
# 2026-08-10 merge: a Rust *symbol*, so none of the path/package/env-var
# patterns above saw it, and it lived in a test file, so only
# `cargo check --all-targets` compiled it.
#
# A bare `ZED_[A-Z_]+` sweep is unusable here — 143 hits, nearly all correct:
# upstream env vars the app still reads, the unported `zed_eval` tool, and Zed
# Cloud's own names. Requiring the PADDLEBOARD_ counterpart is what makes it
# precise. Two real bugs surfaced when this was first run: the shipped debug
# tasks in assets/ used `$ZED_FILE`/`$ZED_WORKTREE_ROOT`, which never resolve.
#
# Names that legitimately keep ZED_ despite having a PADDLEBOARD_ sibling:
SYMBOL_OK=(
  ZED_CLOUD_PROVIDER_ID         # Zed Cloud provider identity, deliberately named
  ZED_CLOUD_PROVIDER_NAME
  ZED_RELEASE_CHANNEL           # build.rs sets a cfg from it, lib.rs reads the same name under that cfg — self-consistent nix/crane path
  ZED_AGENT_MODEL               # upstream eval harness env var
  ZED_GENERATE_MINIDUMPS        # upstream env var (telemetry is inert here anyway)
  ZED_SIMULATE_NO_LLM_PROVIDER  # upstream test hook
  ZED_WINDOW_DECORATIONS        # upstream env var
  ZED_COMMIT_SHA                # Windows build tooling
  ZED_RC_TOOLKIT_PATH           # Windows build tooling
  ZED_META                      # asserted ABSENT by a docs test
  ZED_BUNDLE_TYPE               # snapcraft, not shipped
  ZED_PATH                      # resources/windows/zed.sh, not shipped
)

# Two greps total, then an awk join. Looping a tree-wide grep per renamed
# suffix instead took ~80s, which is not worth paying on every PR.
symbol_failures=0
while IFS= read -r hit; do
  [ -z "$hit" ] && continue
  file="${hit%%:*}"
  file="${file#./}"
  allowlisted "$file" && continue
  echo "ZED-SYMBOL: $hit" >&2
  symbol_failures=$((symbol_failures + 1))
done < <(
  {
    # Suffixes the fork renamed, e.g. AGENT_ID from PADDLEBOARD_AGENT_ID.
    grep -rhoE '\bPADDLEBOARD_[A-Z_]+' crates assets 2>/dev/null \
      | sed 's/^PADDLEBOARD_/RENAMED /' | sort -u
    printf '%s\n' "${SYMBOL_OK[@]}" | sed 's/^ZED_/ALLOWED /'
    grep -rnE '\bZED_[A-Z_]+' crates assets 2>/dev/null \
      | grep -vE ':[0-9]+:[[:space:]]*(//|#|\*)' \
      | grep -vE '\.(md|txt):' \
      | sed 's/^/HIT /'
  } | awk '
      $1 == "RENAMED" { renamed[$2] = 1; next }
      $1 == "ALLOWED" { allowed[$2] = 1; next }
      $1 == "HIT" {
        line = substr($0, 5)
        rest = line
        while (match(rest, /ZED_[A-Z_]+/)) {
          sym = substr(rest, RSTART, RLENGTH)
          suffix = substr(sym, 5)
          if (renamed[suffix] && !allowed[suffix]) { print line; break }
          rest = substr(rest, RSTART + RLENGTH)
        }
      }
    ' || true
)

if [ "$failures" -gt 0 ]; then
  echo "check-zed-isms: $failures reference(s) to renamed Zed paths/packages outside the allowlist." >&2
  echo "Fix the reference (crates/zed -> crates/paddleboard, package zed -> paddleboard)," >&2
  echo "or add the file to ALLOWLIST in script/check-zed-isms if it is unused upstream infra." >&2
fi

if [ "$half_failures" -gt 0 ]; then
  echo "check-zed-isms: $half_failures line(s) say \"Zed\" next to renamed PADDLEBOARD_* code." >&2
  echo "This is the half-rename signature: the symbol was renamed, the prose was not." >&2
  echo "Rename the user-facing text to PaddleBoard, or — if the line means Zed the" >&2
  echo "product (Zed Cloud, an upstream app id) — add its content pattern to" >&2
  echo "HALF_RENAME_OK in script/check-zed-isms." >&2
fi

if [ "$symbol_failures" -gt 0 ]; then
  echo "check-zed-isms: $symbol_failures reference(s) to a ZED_ name this fork renamed." >&2
  echo "The fork defines a PADDLEBOARD_ counterpart, so the ZED_ one is a leftover" >&2
  echo "or an upstream reintroduction — rename it. If the ZED_ name is correct (an" >&2
  echo "upstream env var, or Zed Cloud's own identity), add it to SYMBOL_OK in" >&2
  echo "script/check-zed-isms with a reason." >&2
fi

if [ "$prose_failures" -gt 0 ]; then
  echo "check-zed-isms: $prose_failures user-facing string(s) say \"Zed\"." >&2
  echo "These are sentences a user reads — UI labels, errors, tooltips, clap help." >&2
  echo "Rename to PaddleBoard, or — if the line means Zed the product (Zed Cloud," >&2
  echo "Zed Pro, an upstream font or copyright, internal anyhow context) — add its" >&2
  echo "content pattern to PROSE_OK in script/check-zed-isms with a reason." >&2
fi

if [ "$((failures + half_failures + symbol_failures + prose_failures))" -gt 0 ]; then
  exit 1
fi
echo "check-zed-isms: clean."
